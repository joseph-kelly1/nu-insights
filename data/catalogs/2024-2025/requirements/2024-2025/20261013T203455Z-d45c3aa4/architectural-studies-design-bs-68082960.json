        "NUpath Requirements"
      ],
      "level": 2,
      "entries": [
        {
          "kind": "text",
          "text": "All undergraduate students are required to complete the NUpath Requirements .",
          "links": [
            {
              "text": "NUpath Requirements",
              "url": "https://catalog.northeastern.edu/archive/2024-2025/undergraduate/university-academics/nupath/"
            }
          ],
          "constraints": {},
          "requires_review": true
        },
        {
          "kind": "text",
          "text": "NUpath attributes Engaging with the Natural and Designed World (ND), Exploring Creative Expression and Innovation (EI), Interpreting Culture (IC), Analyzing and Using Data (AD), and Engaging Differences and Diversity (DD) are met through the major course requirements.",
          "links": [],
          "constraints": {},
          "requires_review": true
        },
        {
          "kind": "text",
          "text": "In order to graduate, students must complete Formal and Quantitative Reasoning (FQ) and Ethical Reasoning (ER) in their electives.",
          "links": [],
          "constraints": {},
          "requires_review": true
        },
        {
          "kind": "text",
          "text": "*Note: Students who wish to be eligible for the two-year Master of Architecture degree should take the following courses: Architectonic Systems ( ARCH 2240 ) , Architecture, Infrastructure, and the City ( ARCH 3170 ) , Structural Systems ( ARCH 5230 ) , along with calculus and physics.",
          "links": [],
          "constraints": {},
          "requires_review": true
        }
      ],
