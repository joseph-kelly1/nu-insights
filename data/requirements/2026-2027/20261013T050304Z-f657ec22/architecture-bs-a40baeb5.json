      "entries": [
        {
          "kind": "text",
          "text": "All undergraduate students are required to complete the NUpath Requirements .",
          "links": [
            {
              "text": "NUpath Requirements",
              "url": "https://catalog.northeastern.edu/undergraduate/university-academics/general-education-requirements/#nupathtext"
            }
          ],
          "constraints": {},
          "requires_review": true
        },
        {
          "kind": "text",
          "text": "NUpath attributes Natural and Designed World (ND), Creative Expression and Innovation (EI), Interpreting Culture (IC), Formal and Quantitative Reasoning (FQ), Societies and Institutions (SI), Analyzing and Using Data (AD), and Differences and Diversity (DD) are met through the major course requirements.",
          "links": [],
          "constraints": {},
          "requires_review": true
        },
        {
          "kind": "text",
          "text": "In order to graduate, students must complete Ethical Reasoning (ER) in their electives.",
          "links": [],
          "constraints": {},
          "requires_review": true
        }
      ],
      "container_id": "majorrequirementstextcontainer"
